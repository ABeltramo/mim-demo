# Copy to .env and fill in the required values; compose reads .env automatically.

# Required: credentials for the inference provider behind the OGX gateway.
ENMAAS_KEY=
ENMAAS_BASE_URL=

# Model registered in OGX. Keep garak/mim-demo.yaml's target_name in sync
# when you change these.
MODEL_ID=rits/deepseek-ai/DeepSeek-V4.1-Flash-1017
PROVIDER_MODEL_ID=rits/deepseek-ai/DeepSeek-V4.1-Flash-1017
