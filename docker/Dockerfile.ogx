# OGX Responses gateway, built from the pristine mini-agents submodule with
# its gateway extra and streaming patch. The config is mounted at runtime
# (see compose.yaml). Build context: mim-demo root.

FROM python:3.14-slim-bookworm

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /opt/app-root/src

COPY mini-agents/pyproject.toml .
COPY mini-agents/src ./src
COPY mini-agents/scripts ./scripts

ENV VIRTUAL_ENV=/opt/app-root/.venv
ENV PATH="/opt/app-root/.venv/bin:$PATH"
RUN uv venv /opt/app-root/.venv \
    && uv pip install --no-cache -e . \
        "ogx[starter]" openai botocore chardet sqlite-vec pypdf markitdown \
    && python scripts/patch_ogx_streaming.py

EXPOSE 9321

CMD ["python", "-m", "ogx.cli.ogx", "run", "/config/ogx-config.json", "--insecure"]
